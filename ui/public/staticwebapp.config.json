{
  "routes": [
    {
      "route": "/djportal.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/admin.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/import.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/import",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/import/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/events/create",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/events/update",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/events/delete",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/events/deleteall",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/events/deletecache",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/deployment/rebuild",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/musicrequest/updatestatus",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/login",
      "redirect": "/.auth/login/github?post_login_redirect_uri=/djportal"
    },
    {
      "route": "/",
      "headers": {
        "Link": "</.well-known/api-catalog>; rel=\"api-catalog\", </openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json\", </.well-known/agent-skills/request-a-track/SKILL.md>; rel=\"service-doc\"; type=\"text/markdown\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/json\""
      }
    },
    {
      "route": "/.well-known/api-catalog",
      "rewrite": "/.well-known/api-catalog.json",
      "headers": {
        "Content-Type": "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\"",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "route": "/.well-known/ai-catalog.json",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "route": "/.well-known/agent-skills/*",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "route": "/openapi.json",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    }
  ],
  "mimeTypes": {
    ".xml": "application/xml",
    ".md": "text/markdown; charset=utf-8"
  },
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/github?post_login_redirect_uri=.referrer"
    },
    "404": {
      "rewrite": "/notfound.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
      "content-security-policy": "default-src 'self'; connect-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data:; font-src 'self'; frame-src 'self'; frame-ancestors 'self'; upgrade-insecure-requests; form-action 'self'",
      "X-Frame-Options": "DENY",
      "X-XSS-Protection": "0",
      "Referrer-Policy":"strict-origin-when-cross-origin",
      "X-Content-Type-Options": "nosniff",
      "Strict-Transport-Security": "max-age=63072000"
  }
}
